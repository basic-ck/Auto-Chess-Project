# Unity 생성물 (다시 만들어지므로 백업 불필요)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
*_BurstDebugInformation_DoNotShip/

# IDE / 솔루션 파일 (Unity가 자동 생성)
.vs/
.idea/
.vscode/
*.csproj
*.sln
*.slnx
*.suo
*.user

# 캡처 · 로그 · 임시
/Assets/Screenshots/
/Assets/Screenshots.meta
/Assets/UnityMCP/Log/
*.log

# 바르코 3D에서 받은 큰 3D 파일 (파일 하나가 50MB 이상이라 기록이 너무 커짐)
# 용량을 줄인 뒤 백업에 포함하려면 아래 두 줄을 지우세요. (.meta 파일은 그대로 백업됩니다)
/Assets/Resources/Visuals/**/*.fbx.meta.bak

# 바르코 원본 모델(큰 파일) 보관 폴더
/RawModels/

# 아직 정리 전인 큰 원본 FBX(배경)는 제외. 유닛·타일은 Tools/clean_units.py 로 정리돼 가벼우므로 포함
/Assets/Resources/Visuals/Environment/**/*.fbx

# 빌드 결과물·트레일러 프레임
/Builds/
/TrailerFrames/
/Trailer/
